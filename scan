#!/usr/bin/env bash
set -euo pipefail

SOURCE="$0"
while [ -L "$SOURCE" ]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
AGENTS_DIR="$SCRIPT_DIR/agents"
AGENT_DIR="$AGENTS_DIR/security"
VENV_PYTHON="$AGENTS_DIR/venv/bin/python"

if [ ! -f "$VENV_PYTHON" ]; then
    echo "❌ Error: venv not found at $AGENTS_DIR/venv"
    echo "Run: python3 -m venv $AGENTS_DIR/venv && $AGENTS_DIR/venv/bin/pip install -r $AGENTS_DIR/requirements.txt"
    exit 1
fi

if [ $# -lt 1 ]; then
    echo "Usage: scan <file_or_folder>"
    echo ""
    echo "Examples:"
    echo "  scan myfile.py          # scan a single file"
    echo "  scan .                  # scan current directory"
    echo "  scan src/               # scan a folder"
    exit 1
fi

TARGET="$(cd "$(dirname "$1")" 2>/dev/null && pwd)/$(basename "$1")"
if [ ! -e "$TARGET" ]; then
    echo "❌ Error: '$1' not found."
    exit 1
fi

export SCAN_OUTPUT_DIR="$(pwd)"
export SCAN_TARGET_NAME="$(basename "$1" | sed 's/\.[^.]*$//')"

if [ -f "$TARGET" ]; then
    cd "$AGENT_DIR"
    exec "$VENV_PYTHON" agent.py "$TARGET"
else
    cd "$AGENT_DIR"
    exec "$VENV_PYTHON" scan.py "$TARGET"
fi
