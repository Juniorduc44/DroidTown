#!/usr/bin/env bash
set -euo pipefail

SOURCE="$0"
while [ -L "$SOURCE" ]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
AGENTS_DIR="$SCRIPT_DIR/agents"
AGENT_DIR="$AGENTS_DIR/cli"
VENV_PYTHON="$AGENTS_DIR/venv/bin/python"

GLOBAL_BIN="$HOME/.local/bin/cli"

print_usage() {
    echo "Usage: cli [--install | --uninstall | --status | -h] [task]"
    echo ""
    echo "Agent commands:"
    echo "  cli                           # interactive CLI agent"
    echo "  cli \"list files in this dir\"   # one-shot task"
    echo ""
    echo "Global install commands:"
    echo "  cli --install                 # symlink cli into ~/.local/bin (enable global)"
    echo "  cli --uninstall               # remove the symlink (disable global)"
    echo "  cli --status                  # show whether global install is active"
    echo ""
    echo "Notes:"
    echo "  - Relative paths resolve from the directory where you run 'cli'."
    echo "  - ~/.local/bin must be in your PATH for the global install to work."
}

cmd_install() {
    mkdir -p "$HOME/.local/bin"
    ln -sf "$SCRIPT_DIR/cli" "$GLOBAL_BIN"
    echo "Installed: $GLOBAL_BIN -> $SCRIPT_DIR/cli"
    if ! echo "$PATH" | tr ':' '\n' | grep -qx "$HOME/.local/bin"; then
        echo ""
        echo "NOTE: ~/.local/bin is not in your PATH."
        echo "Add this to your ~/.bashrc or ~/.zshrc, then reload your shell:"
        echo "  export PATH=\"\$HOME/.local/bin:\$PATH\""
    fi
}

cmd_uninstall() {
    if [ ! -L "$GLOBAL_BIN" ]; then
        echo "No symlink found at $GLOBAL_BIN — nothing to remove."
        exit 0
    fi
    TARGET="$(readlink "$GLOBAL_BIN")"
    rm "$GLOBAL_BIN"
    echo "Removed: $GLOBAL_BIN (was -> $TARGET)"
}

cmd_status() {
    if [ -L "$GLOBAL_BIN" ]; then
        TARGET="$(readlink "$GLOBAL_BIN")"
        echo "Global install: ENABLED"
        echo "  $GLOBAL_BIN -> $TARGET"
        if ! echo "$PATH" | tr ':' '\n' | grep -qx "$HOME/.local/bin"; then
            echo "  WARNING: ~/.local/bin is not in your PATH"
        fi
    elif [ -e "$GLOBAL_BIN" ]; then
        echo "Global install: a non-symlink file exists at $GLOBAL_BIN (not managed by this script)"
    else
        echo "Global install: DISABLED (no symlink at $GLOBAL_BIN)"
    fi
    echo "Project root: $SCRIPT_DIR"
}

case "${1:-}" in
    -h|--help)   print_usage; exit 0 ;;
    --install)   cmd_install; exit 0 ;;
    --uninstall) cmd_uninstall; exit 0 ;;
    --status)    cmd_status; exit 0 ;;
esac

if [ ! -f "$VENV_PYTHON" ]; then
    echo "Error: venv not found at $AGENTS_DIR/venv"
    echo "Run: python3 -m venv $AGENTS_DIR/venv && $AGENTS_DIR/venv/bin/pip install -r $AGENTS_DIR/requirements.txt"
    exit 1
fi

# Preserve the directory where the user launched `cli` from, so
# relative file operations in the agent are scoped to that location.
export CLI_AGENT_CWD="$(pwd)"

cd "$AGENT_DIR"

if [ $# -eq 0 ]; then
    exec "$VENV_PYTHON" agent.py
else
    exec "$VENV_PYTHON" agent.py "$@"
fi
